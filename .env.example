# Variabel Lingkungan — Dapur Nusa
# Salin file ini ke .env dan sesuaikan nilainya.
# JANGAN commit file .env ke repositori!

# ============================================================
# Keamanan (WAJIB diubah di production)
# ============================================================

# Secret key Django. Generate baru dengan:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=ganti-dengan-secret-key-yang-kuat

# Debug mode: True untuk development, False untuk production
DEBUG=True

# Host yang diizinkan (pisahkan dengan koma, tanpa spasi)
# Contoh production: ALLOWED_HOSTS=dapurnusa.com,www.dapurnusa.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================
# Keamanan HTTPS (hanya untuk production dengan DEBUG=False)
# ============================================================

# Redirect semua HTTP ke HTTPS (aktifkan jika sudah ada SSL)
SECURE_SSL_REDIRECT=False

# HSTS duration in seconds (0 = nonaktif, 31536000 = 1 tahun)
SECURE_HSTS_SECONDS=0
